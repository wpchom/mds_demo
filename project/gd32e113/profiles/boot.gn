buildconfig = "//BUILDCONFIG.gn"
script_executable = "python3"

export_compile_commands = [ "*" ]

declare_args() {
  target_flags = [
    "-mcpu=cortex-m3",
    "-mthumb",
    "-mfloat-abi=soft",
  ]
}

default_args = {
  # project
  project_profile = "boot"
  project_version = ""

  # profile
  profile_toolchain = "xpack_arm_none_eabi_gcc"
  profile_asmflags = target_flags + [
                       "-x",
                       "assembler-with-cpp",
                     ]
  profile_cflags = target_flags + [
                     "-ffunction-sections",
                     "-fdata-sections",

                     #  "-ffreestanding",

                     "-Wall",
                     "-Wextra",
                     "-Wnull-dereference",
                     "-Wstringop-overflow",
                     "-Wdouble-promotion",
                     "-Wshadow",
                     "-Wlogical-op",
                     "-Wredundant-decls",

                     "-g",
                     "-O2",
                   ]
  profile_cflags_c = []
  profile_cflags_cc = []
  profile_arflags = []
  profile_ldflags = target_flags + [
                      # "--specs=nosys.specs",
                      # "--specs=rdimon.specs",
                      "--specs=nano.specs",
                      "-nostartfiles",
                      "-Wl,--gc-sections",
                      "-Wl,--print-memory-usage",
                      "-Wl,--no-warn-rwx-segments",
                    ]

  import("//profiles/common.gni")

  # gd32e113
  drv_chip_without_irq = true

  # mds
  mds_with_nosys = true
  mds_log_enable = false
}
