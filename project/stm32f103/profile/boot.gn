buildconfig = "//BUILDCONFIG.gn"
script_executable = "python3"

default_args = {
  project_name = "demo_stm32f103"
  project_profile = "boot"

  import("//profile/common.gni")

  # mds
  mds_tick_u64 = false
  mds_library_miniable = true
  mds_object_name_size = 7
  mds_clock_tick_freq_hz = 1000
  mds_core_backtrace_depth = 0

  mds_log_enable = false
  mds_log_build_level = "MDS_LOG_LEVEL_INF"
  mds_log_filter_enable = false
  mds_log_assert_enable = false

  mds_kernel_log_level = "MDS_LOG_LEVEL_WRN"
  mds_kernel_smp_cpus = 1
  mds_kernel_thread_priority_max = 0
  mds_kernel_stats_enable = false

  mds_timer_independent = false
  mds_timer_thread_priority = 0
  mds_timer_thread_stacksize = 256
  mds_timer_thread_ticks = 16

  mds_idle_thread_stacksize = 384
  mds_idle_thread_ticks = 16
  mds_idle_thread_hooks = 0

  # mds_component
  mds_component_algo = true
  mds_component_boot = true
  mds_component_lpc = false

  # mds_component_boot
  mds_boot_upgrade_retry = 3
  mds_boot_upgrade_size = 1024
  mds_boot_upgrade_alloc = false
  mds_boot_upgrade_hash = true
  mds_boot_upgrade_with_copy = true
  mds_boot_upgrade_with_lzma = true
  mds_boot_lzma_read_size = 1024
  mds_boot_lzma_write_size = 1024
  mds_boot_lzma_dict_size = 4096
  mds_boot_lzma_probs_size = 10112
}
