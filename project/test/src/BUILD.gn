pkggroup("mds") {
  deps = [ "kernel" ]
}

executable("${project_name}") {
  sources = [
    "main.c",
    # "test.c",
  ]
  deps = [ ":mds" ]
}

gcc_action("${project_name}.dis") {
  script = "objdump"
  args = [
    "-Shl",
    rebase_path("${root_out_dir}/${project_name}.elf"),
    ">",
    rebase_path("${root_out_dir}/${target_name}"),
  ]
  deps = [ ":${project_name}" ]
  outputs = [ "${root_out_dir}/${target_name}" ]
}

group("default") {
  deps = [ ":${project_name}.dis" ]
}
